# Runtime
ENVIRONMENT=dev
REGION=local
LOG_LEVEL=INFO
METRICS_LOG_INTERVAL_SECONDS=30

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CLIENT_ID=ops-commander
KAFKA_GROUP_INGESTOR=ops-ingestor-v1
KAFKA_GROUP_CORRELATOR=ops-correlator-v1
KAFKA_GROUP_CAUSAL_ENGINE=ops-causal-engine-v1

TOPIC_RAW_LOGS=events.raw.logs
TOPIC_RAW_METRICS=events.raw.metrics
TOPIC_RAW_ALERTS=events.raw.alerts
TOPIC_NORMALIZED=events.normalized
TOPIC_INCIDENT_CANDIDATES=incidents.candidates
TOPIC_INCIDENT_DIAGNOSED=incidents.diagnosed
TOPIC_INCIDENT_REPORTS=incidents.reports

# Correlator
CORR_ALLOWED_LATENESS_SECONDS=20
CORR_MERGE_GAP_SECONDS=15
CORR_CLOSE_AFTER_SECONDS=45
CORR_LATE_CORRECTION_GRACE_SECONDS=40
CORR_MAX_LINK_GAP_SECONDS=45

# Reporter API
REPORTER_API_HOST=0.0.0.0
REPORTER_API_PORT=8000

# Replay worker
REPLAY_WORKER_MODE=queue
REPLAY_ARCHIVE_PATH=data/archive
REPLAY_EVALUATIONS_PATH=data/archive/evaluations
REPLAY_POLL_SECONDS=3
REPLAY_DIAGNOSIS_LINGER_SECONDS=15
REPLAY_DEFAULT_SPEED_FACTOR=1.0
REPLAY_SCENARIO=

# Simulator archive and chaos controls
SIM_ARCHIVE_ENABLED=true
SIM_ARCHIVE_PATH=data/archive
CHAOS_SIM_DROP_RATE=0.0
CHAOS_INGESTOR_DROP_RATE=0.0
CHAOS_CORRELATOR_DROP_RATE=0.0
CHAOS_CAUSAL_ENGINE_DROP_RATE=0.0

# Postgres
DB_HOST=localhost
DB_PORT=15432
DB_NAME=ops_commander
DB_USER=ops
DB_PASSWORD=ops
DB_ECHO=false

# Simulator
SIM_TICK_SECONDS=1.0
SIM_OUT_OF_ORDER_PCT=0.05
SIM_SCENARIO=default_cascade
